# Windows resource compiler
# PeepeeBox: anchored to the repository root.  Unanchored, this pattern matches
# at any depth -- and because git on Windows is case-insensitive by default it
# also matches lowercase 'rc', which silently swallowed all 209 files of
# src/qt/qdarkstyle/dark/rc/ when this repository was first populated.  Anyone
# cloning it could not build the Qt GUI.
/RC*

# Qt Creator
CMakeLists.txt.user

# Debian builder
/debian/*.log
/debian/*.substvars
/debian/.debhelper
/debian/86box
/debian/debhelper-build-stamp
/debian/files
/obj-*-linux-gnu

# MacOS Finder stuff
.DS_Store

# clangd
.cache

# Jetbrains CLion
.idea

# Disk images.  These are gigabytes each and are not ours to redistribute.
# PP2000/ and PP2001/ hold nothing but these, so the one pattern covers them.
*.img

# Packaged release folders -- an 80 MB binary each, built from a tag
/Release */

# Python bytecode from running the evidence helpers in place
__pycache__/
*.pyc

# Multi-hundred-MB archive caches built by the picture-cipher scripts
findit_wads.pkl
fpairs.pkl
