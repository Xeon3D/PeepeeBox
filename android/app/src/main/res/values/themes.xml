<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PeepeeBox" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#1B1B1F</item>
        <item name="android:colorAccent">#4FC3F7</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#1B1B1F</item>
        <item name="android:navigationBarColor">#1B1B1F</item>
    </style>

    <!-- A bottom-bar button: icon over label, one fifth of the width. -->
    <style name="ActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
