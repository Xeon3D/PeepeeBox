<?xml version="1.0" encoding="utf-8"?>
<!-- The Machine Manager: the images in the app's folder; a tap runs one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121214">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/actionBarSize"
        android:background="#1B1B1F"
        android:title="@string/machine_manager"
        android:titleTextColor="#FFFFFF"
        android:subtitleTextColor="#B8B8C0" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="#B8B8C0"
            android:textSize="16sp"
            android:text="@string/no_images" />
    </FrameLayout>

</LinearLayout>
